  config.vm.define "isoloom-controller" do |m|
    m.vm.box = "bento/debian-12"
    m.vm.hostname = "isoloom-controller"
    m.vm.network "private_network", ip: "192.168.56.253", netmask: "255.255.255.0", virtualbox__intnet: "isoloom-goad-lab", libvirt__network_name: "isoloom-goad-lab", libvirt__dhcp_enabled: false
    m.vm.provider "virtualbox" do |v|
      v.name = "goad · controller"
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "vmware_desktop" do |v|
      v.vmx["displayName"] = "goad · controller"
      v.vmx["numvcpus"] = "1"
      v.vmx["memsize"] = "1024"
    end
    m.vm.provider "parallels" do |v|
      v.name = "goad · controller"
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "libvirt" do |v, o|
      o.vm.box = "generic/debian12"
      v.cpus = 1
      v.memory = 1024
    end
    m.vm.provider "vmware_esxi" do |v|
      v.esxi_hostname = ENV.fetch("ESXI_HOSTNAME", "")
      v.esxi_hostport = ENV.fetch("ESXI_HOSTPORT", "22").to_i
      v.esxi_username = ENV.fetch("ESXI_USERNAME", "root")
      v.esxi_password = "env:ESXI_PASSWORD"
      v.esxi_disk_store = ENV["ESXI_DATASTORE"] if ENV["ESXI_DATASTORE"]
      v.esxi_virtual_network = esxi_networks(["lab"])
      v.guest_name = "goad-controller"
      v.guest_numvcpus = 1
      v.guest_memsize = 1024
    end
    m.vm.provision "shell", name: "hosts", inline: "for l in '192.168.56.10 dc01' '192.168.56.11 dc02' '192.168.56.12 dc03' '192.168.56.22 srv02' '192.168.56.23 srv03'; do grep -qxF \"$l\" /etc/hosts || echo \"$l\" >> /etc/hosts; done"
    PROJECT.each do |entry|
      m.vm.provision "file", source: File.join(ROOT, entry), destination: "/tmp/isoloom-project/#{entry}"
    end
    m.vm.provision "shell", name: "project", inline: "rm -rf /opt/isoloom && mv /tmp/isoloom-project /opt/isoloom"
    m.vm.provision "shell", name: "controller", inline: <<~'SH'
      set -e
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -qq
      apt-get install -y -qq python3-venv sshpass curl netcat-openbsd >/dev/null
      [ -x /opt/ansible/bin/ansible-playbook ] || { python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q 'ansible-core>=2.15,<2.17' pywinrm; }
      mkdir -p /etc/isoloom
      cat > /etc/isoloom/inventory.ini <<'INV'
      [linux]


      [windows]
      dc01 ansible_host=192.168.56.10
      dc02 ansible_host=192.168.56.11
      dc03 ansible_host=192.168.56.12
      srv02 ansible_host=192.168.56.22
      srv03 ansible_host=192.168.56.23

      [linux:vars]
      ansible_user=vagrant
      ansible_password=vagrant
      ansible_become=true

      [windows:vars]
      ansible_user=vagrant
      ansible_password=vagrant
      ansible_connection=winrm
      ansible_port=5985
      ansible_winrm_scheme=http
      ansible_winrm_transport=basic
      ansible_winrm_server_cert_validation=ignore
      ansible_winrm_operation_timeout_sec=400
      ansible_winrm_read_timeout_sec=500
      INV
    SH
    m.vm.provision "shell", name: "ansible", inline: <<~'SH'
      set -e
      export PATH=/opt/ansible/bin:$PATH ANSIBLE_HOST_KEY_CHECKING=False
      cd /opt/isoloom/ansible
      ansible-galaxy install -r /opt/isoloom/ansible/requirements_311.yml
      ansible-playbook -i /etc/isoloom/inventory.ini -i /opt/isoloom/ad/GOAD/data/inventory -i /opt/isoloom/ad/GOAD/providers/isoloom/inventory -i /opt/isoloom/globalsettings.ini main.yml
    SH
  end
